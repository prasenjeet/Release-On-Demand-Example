{
  "name": "acme-api",
  "version": "2.0.0",
  "description": "Acme Shop API — Release on Demand demo with Prometheus metrics + Unleash feature flags",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "jest --forceExit",
    "test:ci": "jest --forceExit --ci --coverage"
  },
  "dependencies": {
    "express": "^4.19.2",
    "prom-client": "^15.1.3",
    "unleash-client": "^6.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/test/**/*.test.js"]
  }
}
